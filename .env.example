# Backend base URL (NestJS). Every request goes to ${NEXT_PUBLIC_API_URL}/<endpoint>.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# "mock" = in-memory backend in the browser that implements the same API contract (no server needed).
# "live" = real backend at NEXT_PUBLIC_API_URL. No UI code changes between the two.
NEXT_PUBLIC_API_MODE=mock

# Reown (WalletConnect) project ID from https://dashboard.reown.com — enables the
# WalletConnect QR fallback for wallets that aren't injected in the browser.
# Leave empty to hide the QR option; Trust Wallet's in-app browser / extension still works.
NEXT_PUBLIC_REOWN_PROJECT_ID=
